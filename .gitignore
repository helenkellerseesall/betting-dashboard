# secrets
.env
.env.*
backend/.env
frontend/.env
frontend/.env.*

# dependencies
**/node_modules/

# build output
**/dist/
**/.vite/
# macOS
.DS_Store

# env
.env
.env.*

# logs
*.log

# caches / generated data
backend/api-sports-cache.json
backend/snapshot.json
backend/snapshot-fixture.json
backend/manual-outcomes.json

# backups
*.bak

# node
node_modules/
frontend/node_modules/
backend/node_modules/

# runtime/generated
# NOTE: Use directory-content exclusion (backend/runtime/*) not whole-dir
# (backend/runtime/) so we can re-include backend/runtime/supervisor/ source.
# git ignores child re-inclusions when the PARENT directory is excluded.
backend/runtime/*
!backend/runtime/supervisor
!backend/runtime/supervisor/**
# Re-exclude generated supervisor artifacts (daemon writes these):
backend/runtime/supervisor/state.lock
backend/runtime/supervisor/state.json
backend/runtime/supervisor/events.log.jsonl
backend/runtime/supervisor/*.tmp.*
backend/snapshot-mlb.json
backend/mlb-external-cache.json
*.log
node_modules/

# SQLite database files (schema/queries/importScript committed; .db files are local only)
backend/storage/*.db
backend/storage/*.db-shm
backend/storage/*.db-wal
backend/storage/*.db-journal
backend/storage/test.txt

# Checkpoint state (local operational state — never commit)
.checkpoint/
.scratch/
