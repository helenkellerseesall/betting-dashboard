# secrets
.env
.env.*
backend/.env
frontend/.env
frontend/.env.*

# dependencies
**/node_modules/

# build output
**/dist/
**/.vite/
# macOS
.DS_Store

# env
.env
.env.*

# logs
*.log

# caches / generated data
backend/api-sports-cache.json
backend/snapshot.json
backend/snapshot-fixture.json
backend/manual-outcomes.json

# backups
*.bak

# node
node_modules/
frontend/node_modules/
backend/node_modules/

# runtime/generated
# NOTE: Use directory-content exclusion (backend/runtime/*) not whole-dir
# (backend/runtime/) so we can re-include backend/runtime/supervisor/ source.
# git ignores child re-inclusions when the PARENT directory is excluded.
backend/runtime/*
!backend/runtime/supervisor
!backend/runtime/supervisor/**
# Re-exclude generated supervisor artifacts (daemon writes these):
backend/runtime/supervisor/state.lock
backend/runtime/supervisor/state.json
backend/runtime/supervisor/events.log.jsonl
backend/runtime/supervisor/*.tmp.*
backend/snapshot-mlb.json
backend/mlb-external-cache.json
*.log
node_modules/

# SQLite database files (schema/queries/importScript committed; .db files are local only)
backend/storage/*.db
backend/storage/*.db-shm
backend/storage/*.db-wal
backend/storage/*.db-journal
backend/storage/test.txt

# Checkpoint state (local operational state — never commit)
.checkpoint/
.scratch/

# 2026-05-31 — populator outputs (regenerated every slate by refresh*.js scripts).
# These were tracked historically, which blocked `git pull --rebase` after every
# slate run because the populators modify them. Also: mlbLiveStateHistory/ was
# 431MB in git history. We KEEP the curated static seeds (mlbParkFactors.json,
# mlbParkMeta.json, sportsbookTopology.json) — those are hand-edited reference data.
backend/data/intelligence.db
backend/data/mlbBatterGameLogs.json
backend/data/mlbBatterStats.json
backend/data/mlbBullpenWorkload.json
backend/data/mlbGameWeather.json
backend/data/mlbPitcherGameLogs.json
backend/data/mlbPitcherStats.json
backend/data/mlbPlayerPower.json
backend/data/mlbStatcastPower.json
backend/data/nbaDvP.json
backend/data/nbaInjuryReport.json
backend/data/nbaPlayerGameLogs.json
backend/data/nbaPlayerProjections.json
backend/data/nbaTeamStats.json
backend/data/mlbLiveStateHistory/

# Also bak files from past slate scripts
backend/scripts/*.bak*

# 2026-06-02 — runtime caches/state (regenerated; never commit)
backend/data/mlbLineupCache.json
backend/data/nbaSeriesStateAuto.json
backend/storage/*.sqlite
